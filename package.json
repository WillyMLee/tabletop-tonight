{
  "name": "tabletop-tonight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p convex --noEmit",
    "check": "npm run typecheck && npm run build",
    "verify:live": "node scripts/verify-live-sync.mjs",
    "verify:join": "node scripts/verify-guest-join.mjs",
    "verify:puzzles": "node scripts/verify-puzzle-data.mjs",
    "reset:live": "node scripts/reset-game-night.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "deploy:live": "convex deploy --yes --cmd \"npm run build\" && wrangler deploy",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "convex": "^1.42.3",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wordle-words": "^0.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  }
}
