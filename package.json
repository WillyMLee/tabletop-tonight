{
  "name": "tabletop-tonight",
  "private": true,
  "version": "1.0.0",
  "description": "A realtime, mobile-first game-night hub built with React, Convex, and Cloudflare Workers.",
  "homepage": "https://tabletop-tonight.willymlee.workers.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillyMLee/tabletop-tonight.git"
  },
  "license": "MIT",
  "keywords": ["game-night", "react", "convex", "cloudflare-workers", "realtime"],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p convex --noEmit",
    "check": "npm run typecheck && npm run build",
    "verify": "npm run verify:puzzles && npm run verify:circuit && npm run check",
    "verify:live": "node scripts/verify-live-sync.mjs",
    "verify:join": "node scripts/verify-guest-join.mjs",
    "verify:winners": "node scripts/verify-winner-scoring.mjs",
    "verify:willy-reset": "node scripts/verify-willy-reset.mjs",
    "verify:puzzle-scoring": "node scripts/verify-puzzle-scoring.mjs",
    "verify:puzzles": "node scripts/verify-puzzle-data.mjs",
    "verify:circuit": "node --experimental-strip-types scripts/verify-circuit.mjs",
    "reset:live": "node scripts/reset-game-night.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "predeploy": "npm run verify",
    "deploy": "convex deploy --yes --cmd \"npm run build\" && wrangler deploy",
    "deploy:live": "npm run deploy",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "convex": "^1.42.3",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wordle-words": "^0.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  }
}
