# `npx convex dev` fills in the deployment values after project setup.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# Public invite capability used to select one shared event. Use 6–64 lowercase
# letters, numbers, and hyphens. This value is not an authentication secret.
VITE_GAME_NIGHT_KEY=replace-with-a-long-unique-event-key
